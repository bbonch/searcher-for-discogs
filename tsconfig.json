{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "dist",
        "sourceMap": true,
        "strictNullChecks": true,
        "module": "Node16",
        "jsx": "react",
        "target": "es6",
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "moduleResolution": "node16",
        "types": [
            "jquery",
            "node",
            "gtag.js"
        ]
    },
    "include": [
        "./src/"
    ]
}